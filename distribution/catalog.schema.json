{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Meta-skills distribution catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "release", "skills", "bundles"],
  "properties": {
    "version": {"const": 1},
    "release": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "skills": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "maxLength": 64, "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
    },
    "bundles": {
      "type": "object",
      "additionalProperties": {
        "type": "array", "minItems": 1, "uniqueItems": true,
        "items": {"type": "string"}
      }
    }
  }
}
